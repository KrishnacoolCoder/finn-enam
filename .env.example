# Optional. These variables are read from the process environment, not automatically loaded from this file.
GEMINI_API_KEY=
# Optional backup; also works by itself when Gemini is not configured.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
FINN_DATA_DIR=./data
# 0 = disabled (default). To run EOD checks every 60 minutes on an always-on server, set 60.
FINN_AUTO_POLL_MINUTES=0
